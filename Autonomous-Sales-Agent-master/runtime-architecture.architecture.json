  "cards": [
    {
      "dot": "cyan",
      "title": "Primary Runtime Flow",
      "items": [
        "Inbound lead message triggers LangGraph StateGraph pipeline",
        "Triage node evaluates qualification stage and BANT score (1-10)",
        "Reasoner LLM node invokes tools (KB search, Cal.com scheduling, CRM stage sync)",
        "State checkpointer (MemorySaver) maintains conversational history across turns"
      ]
    },
    {
      "dot": "emerald",
      "title": "Async Workers & External Dispatches",
      "items": [
        "Celery Beat schedules periodic sweeps (every 30 min) for stalled leads in BOOKING_OFFERED",
        "Celery invokes LangGraph to generate context-aware nudges and dispatches via Resend Email",
        "T-minus 2 min presence check triggers automated Twilio voice calls & WhatsApp prompts if lead is absent"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust Boundaries & Resilience",
      "items": [
        "Private VPC boundary isolates LangGraph runtime, SQLite/PostgreSQL CRM, and Redis broker",
        "External HTTPS boundary manages authenticated API access to OpenRouter, Cal.com, Resend, Twilio",
        "Multi-LLM fallback chain (Gemma 4 -> Nemotron 3.5 -> Apodex) guarantees continuous availability"
      ]
    }
  ]
